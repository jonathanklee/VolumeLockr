<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

  <PreferenceCategory app:title="@string/limiting_header">

    <SwitchPreferenceCompat
        app:key="allow_lower"
        app:title="@string/allow_lower"
        app:summary="@string/allow_lower_summary"
        app:defaultValue="false" />

  </PreferenceCategory>

  <PreferenceCategory app:title="@string/sound_feedback_header">

    <SwitchPreferenceCompat
        app:key="play_sound_preview"
        app:title="@string/play_sound_preview"
        app:summary="@string/play_sound_preview_summary"
        app:defaultValue="true" />

  </PreferenceCategory>

  <PreferenceCategory app:title="@string/password_header">

    <SwitchPreferenceCompat
        app:key="password_protected"
        app:title="@string/password_protected"
        app:summary="@string/password_protected_summary" />

    <Preference
        app:key="password"
        app:title="@string/change_password"
        app:summary="@string/change_password_summary" />

  </PreferenceCategory>

  <PreferenceCategory app:title="@string/about">

    <Preference
        app:key="github_star"
        app:title="@string/github_star" />

    <Preference
        app:key="donate"
        app:title="@string/donate" />

    <Preference
        app:key="version"
        app:title="@string/version" />

  </PreferenceCategory>

</PreferenceScreen>
